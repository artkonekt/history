{
    "name": "konekt/history",
    "description": "Eloquent Model History for Laravel",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": ["history", "eloquent", "laravel", "konekt"],
    "support": {
        "source": "https://github.com/artkonekt/history",
        "issues": "https://github.com/artkonekt/history/issues"
    },
    "require": {
        "php": "^8.3",
        "konekt/concord": "^1.14",
        "konekt/enum": "^3.1|^4.0",
        "konekt/enum-eloquent": "^1.10",
        "illuminate/database": "^11.46.2|^12.50|^13.0",
        "illuminate/support": "^11.46.2|^12.50|^13.0",
        "konekt/laravel-migration-compatibility": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Konekt\\History\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Konekt\\History\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    }
}
